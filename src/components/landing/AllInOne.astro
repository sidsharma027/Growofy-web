---
const { class: className } = Astro.props;
---

<!-- The Growofy Growth System™ - 4 Pillars -->
<section id="all-in-one" class:list={["all-in-one-section relative text-white", className]}>
	<div class="wrapper col-span-12 min-h-screen w-full">
		<div class="line-animation-wrapper h-full min-h-[110rem]">
			<svg id="all-in-one-svg" class="absolute" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 1200">
				<!-- https://yqnn.github.io/svg-path-editor/ -->
				<path
					class="all-in-one-line-path"
					d="M -5 0 Q 334 135 189 164 T 227 362 A 1 1 0 0 0 302 268 A 1 1 0 0 0 215 410 C 274 443 324 481 322 552 C 310 703 365 610 983 719"
					fill="none"
					stroke="white"
					stroke-width="5px">
				</path>
			</svg>
		</div>

		<div class="min-h-[150rem]">
			<div>
				<h2>The Growofy Growth System™</h2>
			</div>
			<div>
				<h3>4 Pillars. 1 Revenue Machine.</h3>
			</div>

			<div class="mx-auto mt-16 max-w-6xl px-4">
				<div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-4">
					<!-- Pillar 1: Digital Foundation -->
					<div class="rounded-2xl border border-zinc-700 bg-zinc-900 p-8">
						<div class="mb-4 inline-block rounded-lg bg-zinc-700 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">Pillar 01</div>
						<h4 class="mb-4 text-2xl font-bold text-white lg:text-3xl">Digital Foundation</h4>
						<p class="mb-6 text-white">Your complete online infrastructure, built from the ground up to convert visitors into paying customers.</p>
						<ul class="space-y-3 text-sm text-white">
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Shopify or Custom Website</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Payment Gateway Integration</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> WhatsApp Integration</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Tracking Setup (Meta Pixel, GA4)</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Basic SEO Optimization</li>
						</ul>
					</div>

					<!-- Pillar 2: Traffic Engine -->
					<div class="rounded-2xl border border-zinc-700 bg-zinc-900 p-8">
						<div class="mb-4 inline-block rounded-lg bg-zinc-700 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">Pillar 02</div>
						<h4 class="mb-4 text-2xl font-bold text-white lg:text-3xl">Traffic Engine</h4>
						<p class="mb-6 text-white">Targeted campaigns that bring your ideal customers straight to your doorstep — digital or physical.</p>
						<ul class="space-y-3 text-sm text-white">
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Meta Ads (Facebook + Instagram)</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Lead Generation Campaigns</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> WhatsApp Ads</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Retargeting Campaigns</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Location-based Ads</li>
						</ul>
					</div>

					<!-- Pillar 3: Conversion Optimization -->
					<div class="rounded-2xl border border-zinc-700 bg-zinc-900 p-8">
						<div class="mb-4 inline-block rounded-lg bg-zinc-700 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">Pillar 03</div>
						<h4 class="mb-4 text-2xl font-bold text-white lg:text-3xl">Conversion Optimization</h4>
						<p class="mb-6 text-white">Turning clicks into customers through strategic funnel design and revenue-maximizing offer structures.</p>
						<ul class="space-y-3 text-sm text-white">
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Funnel Design & Build</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Offer Structuring</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Subscription Model Setup</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Landing Page Optimization</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Upsell & Cross-sell Systems</li>
						</ul>
					</div>

					<!-- Pillar 4: Scale & Expansion -->
					<div class="rounded-2xl border border-zinc-700 bg-zinc-900 p-8">
						<div class="mb-4 inline-block rounded-lg bg-zinc-700 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">Pillar 04</div>
						<h4 class="mb-4 text-2xl font-bold text-white lg:text-3xl">Scale & Expansion</h4>
						<p class="mb-6 text-white">Once your system is generating results, we systematically scale what works and unlock new growth levers.</p>
						<ul class="space-y-3 text-sm text-white">
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Campaign Scaling</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Creative Testing</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Data Analysis & Reporting</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Budget Optimization</li>
							<li class="flex items-start gap-2"><span class="mt-1 text-lime-500">→</span> Monthly Strategy Planning</li>
						</ul>
					</div>
				</div>
				<p class="mt-12 text-center text-lg text-zinc-800">
					This isn't a menu of random services. It's a <span class="font-semibold text-zinc-900">structured system</span> designed to take your business from offline to consistently generating online revenue.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	// import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

	gsap.registerPlugin(ScrollTrigger); //, DrawSVGPlugin);

	function init() {
		const linePath = document.querySelector(".all-in-one-line-path");

		// gsap.set(linePath, { drawSVG: 0 });

		gsap.timeline({
			scrollTrigger: {
				trigger: ".line-animation-wrapper",
				scrub: 1,
				start: "top center",
				end: "bottom center",
				markers: false,
			},
			defaults: { ease: "none" },
		});
		// .to(
		// 	linePath,
		// 	{
		// 		drawSVG: "100%",
		// 		// ease: "power4.in",
		// 	},
		// 	0,
		// );
	}

	document.removeEventListener("DOMContentLoaded", init); // astro:page-load
	document.addEventListener("DOMContentLoaded", init); // astro:page-load
</script>
