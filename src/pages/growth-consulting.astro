---
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = {
  title: "Growth Consulting - Growofy",
  description: "Strategic partnerships for 8-figure brands. We help you with pricing, product strategy, channel expansion, and operational scaling.",
};
---

<BaseLayout seo={seo}>
  <!-- Hero Section -->
  <section class="section py-20 lg:py-32 bg-zinc-950 text-white min-h-[70vh] flex items-center">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
      <h1 class="font-display text-5xl lg:text-7xl font-bold uppercase tracking-tight mb-6">
        Beyond <span class="text-cyan-500">Tactics.</span>
      </h1>
      <p class="text-lg lg:text-xl text-zinc-400 mb-10 max-w-2xl mx-auto">
        Ads are just one piece of the puzzle. We work with founders to fix pricing, optimize unit economics, restructure product lines, and build a master plan for 10X growth.
      </p>
      <div class="flex justify-center">
        <div class="squircle-bg rounded-lg bg-white text-black">
          <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold">
            Book Strategy Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section py-20 bg-white text-zinc-900">
    <div class="col-span-12 lg:col-span-6 lg:col-start-2">
      <h2 class="font-display text-3xl lg:text-5xl font-bold uppercase mb-8">Strategic Partnership.</h2>
      <p class="text-lg text-zinc-600 mb-6">
        Sometimes the bottleneck isn't traffic. It's your offer. Or your margins. Or your operations. We come in as strategic partners (fractional CMOs) to audit your entire business model and align your digital efforts with your financial goals.
      </p>
      <ul class="space-y-4 text-zinc-800 font-medium">
        <li class="flex items-center gap-2"><span class="text-cyan-600">✓</span> Business Model Audit</li>
        <li class="flex items-center gap-2"><span class="text-cyan-600">✓</span> Unit Economics Optimization</li>
        <li class="flex items-center gap-2"><span class="text-cyan-600">✓</span> Omnichannel Expansion Strategy</li>
        <li class="flex items-center gap-2"><span class="text-cyan-600">✓</span> Team Hiring & Training Support</li>
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section py-20 bg-zinc-50">
      <div class="col-span-12 text-center mb-16">
          <h2 class="font-display text-4xl font-bold uppercase">Our Consulting Process</h2>
      </div>
      <div class="col-span-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">01</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Deep Dive Audit</h3>
              <p class="text-zinc-500">We tear apart your P&L, customer data, and current marketing stack.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">02</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Strategic Roadmap</h3>
              <p class="text-zinc-500">We build a 12-month execution plan focused on profit, not just revenue.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">03</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Execution Support</h3>
              <p class="text-zinc-500">We guide your team weekly to ensure milestones are hit.</p>
          </div>
      </div>
  </section>

  <!-- Who It's For -->
  <section class="section py-20 bg-zinc-900 text-white">
      <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
          <h2 class="font-display text-3xl mb-6">Who This Is For</h2>
          <p class="text-xl text-zinc-400">
              Founders doing ₹1Cr+ annual revenue looking to break through a plateau.
          </p>
      </div>
  </section>

  <!-- CTA -->
  <section class="section py-32 bg-cyan-500 text-white text-center">
      <div class="col-span-12">
          <h2 class="font-display text-4xl lg:text-6xl font-bold uppercase mb-8">Ready to Build a Revenue System?</h2>
          <div class="flex justify-center">
            <div class="squircle-bg rounded-lg bg-black text-white">
              <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold hover:text-cyan-400 transition-colors">
                Book Strategy Call
              </a>
            </div>
          </div>
      </div>
  </section>

</BaseLayout>
