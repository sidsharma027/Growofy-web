---
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = {
  title: "Shopify Development - Growofy",
  description: "High-performance Shopify storefronts built for conversions. UPI integration, custom themes, and speed optimization for Indian e-commerce businesses.",
};
---

<BaseLayout seo={seo}>
  <!-- Hero Section -->
  <section class="section py-20 lg:py-32 bg-zinc-950 text-white min-h-[70vh] flex items-center">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
      <h1 class="font-display text-5xl lg:text-7xl font-bold uppercase tracking-tight mb-6">
        Shopify Stores That <span class="text-lime-400">Actually Sell</span>
      </h1>
      <p class="text-lg lg:text-xl text-zinc-400 mb-10 max-w-2xl mx-auto">
        Stop using generic templates. We build custom, conversion-optimized Shopify stores designed for the Indian market with seamless UPI & WhatsApp integration.
      </p>
      <div class="flex justify-center">
        <div class="squircle-bg rounded-lg bg-white text-black">
          <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold">
            Book Strategy Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section py-20 bg-white text-zinc-900">
    <div class="col-span-12 lg:col-span-6 lg:col-start-2">
      <h2 class="font-display text-3xl lg:text-5xl font-bold uppercase mb-8">No Template Garbage. Built to Convert.</h2>
      <p class="text-lg text-zinc-600 mb-6">
        Most agencies slap a free theme on your store and call it development. We don't do that. We build revenue-focused infrastructure. From lightning-fast loading speeds to one-click UPI checkouts, every pixel is engineered to maximize your Average Order Value (AOV).
      </p>
      <ul class="space-y-4 text-zinc-800 font-medium">
        <li class="flex items-center gap-2"><span class="text-lime-600">✓</span> Custom Liquid Development</li>
        <li class="flex items-center gap-2"><span class="text-lime-600">✓</span> Seamless UPI & COD Integration</li>
        <li class="flex items-center gap-2"><span class="text-lime-600">✓</span> Automated Abandoned Cart Recovery</li>
        <li class="flex items-center gap-2"><span class="text-lime-600">✓</span> Mobile-First Optimization</li>
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section py-20 bg-zinc-50">
      <div class="col-span-12 text-center mb-16">
          <h2 class="font-display text-4xl font-bold uppercase">Our Development Process</h2>
      </div>
      <div class="col-span-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">01</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Strategy & Wireframe</h3>
              <p class="text-zinc-500">We map out your user journey to ensure friction-less purchasing.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">02</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Build & Optimize</h3>
              <p class="text-zinc-500">Custom coding, app integration, and speed optimization for < 2s load times.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">03</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Launch & Scale</h3>
              <p class="text-zinc-500">We launch your store with full tracking setup (Pixel/GA4) ready for ads.</p>
          </div>
      </div>
  </section>

  <!-- Who It's For -->
  <section class="section py-20 bg-zinc-900 text-white">
      <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
          <h2 class="font-display text-3xl mb-6">Who This Is For</h2>
          <p class="text-xl text-zinc-400">
              D2C Brands, Retail Stores moving online, and Wholesalers wanting a digital catalog. If you're serious about online sales, this is for you.
          </p>
      </div>
  </section>

  <!-- CTA -->
  <section class="section py-32 bg-lime-400 text-black text-center">
      <div class="col-span-12">
          <h2 class="font-display text-4xl lg:text-6xl font-bold uppercase mb-8">Ready to Build a Revenue System?</h2>
          <div class="flex justify-center">
            <div class="squircle-bg rounded-lg bg-black text-white">
              <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold hover:text-lime-400 transition-colors">
                Book Strategy Call
              </a>
            </div>
          </div>
      </div>
  </section>

</BaseLayout>
