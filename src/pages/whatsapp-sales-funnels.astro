---
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = {
  title: "WhatsApp Sales Funnels - Growofy",
  description: "Automate your sales with WhatsApp. Recover abandoned carts, send personalized offers, and close leads on autopilot.",
};
---

<BaseLayout seo={seo}>
  <!-- Hero Section -->
  <section class="section py-20 lg:py-32 bg-zinc-950 text-white min-h-[70vh] flex items-center">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
      <h1 class="font-display text-5xl lg:text-7xl font-bold uppercase tracking-tight mb-6">
        Sell Where They <span class="text-green-500">Live.</span>
      </h1>
      <p class="text-lg lg:text-xl text-zinc-400 mb-10 max-w-2xl mx-auto">
        Emails get ignored. WhatsApp gets opened. We build automated WhatsApp sales funnels that recover carts, nurture leads, and generate revenue on autopilot.
      </p>
      <div class="flex justify-center">
        <div class="squircle-bg rounded-lg bg-white text-black">
          <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold">
            Book Strategy Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section py-20 bg-white text-zinc-900">
    <div class="col-span-12 lg:col-span-6 lg:col-start-2">
      <h2 class="font-display text-3xl lg:text-5xl font-bold uppercase mb-8">98% Open Rates. Instant Sales.</h2>
      <p class="text-lg text-zinc-600 mb-6">
        In India, business happens on WhatsApp. If you aren't using WhatsApp API automation, you are leaving money on the table. We set up official WhatsApp Business API systems to send broadcast campaigns, abandoned cart reminders, and automated customer support flows.
      </p>
      <ul class="space-y-4 text-zinc-800 font-medium">
        <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Official WhatsApp API Verification (Green Tick)</li>
        <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Automated Abandoned Cart Recovery</li>
        <li class="flex items-center gap-2"><span class="text-green-600">✓</span> COD Confirmation Flows</li>
        <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Bulk Broadcast Marketing</li>
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section py-20 bg-zinc-50">
      <div class="col-span-12 text-center mb-16">
          <h2 class="font-display text-4xl font-bold uppercase">Our Automation Process</h2>
      </div>
      <div class="col-span-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">01</span>
              <h3 class="text-xl font-bold mt-4 mb-2">API Setup</h3>
              <p class="text-zinc-500">We get your business verified with Meta and set up the official API.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">02</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Flow Design</h3>
              <p class="text-zinc-500">We map out chat flows: Welcome, Nurture, Offer, Close.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">03</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Launch</h3>
              <p class="text-zinc-500">Your "Sales Bot" goes live, handling customers 24/7/365.</p>
          </div>
      </div>
  </section>

  <!-- Who It's For -->
  <section class="section py-20 bg-zinc-900 text-white">
      <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
          <h2 class="font-display text-3xl mb-6">Who This Is For</h2>
          <p class="text-xl text-zinc-400">
              E-commerce brands (Shopify/WooCommerce), Service businesses with high lead volume, and Educational Institutes.
          </p>
      </div>
  </section>

  <!-- CTA -->
  <section class="section py-32 bg-green-500 text-white text-center">
      <div class="col-span-12">
          <h2 class="font-display text-4xl lg:text-6xl font-bold uppercase mb-8">Ready to Build a Revenue System?</h2>
          <div class="flex justify-center">
            <div class="squircle-bg rounded-lg bg-black text-white">
              <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold hover:text-green-400 transition-colors">
                Book Strategy Call
              </a>
            </div>
          </div>
      </div>
  </section>

</BaseLayout>
