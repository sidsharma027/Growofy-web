---
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = {
  title: "Custom Website Development - Growofy",
  description: "Bespoke digital experiences built for competitive differentiation. High-speed, secure, and scalable custom web development.",
};
---

<BaseLayout seo={seo}>
  <!-- Hero Section -->
  <section class="section py-20 lg:py-32 bg-zinc-950 text-white min-h-[70vh] flex items-center">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
      <h1 class="font-display text-5xl lg:text-7xl font-bold uppercase tracking-tight mb-6">
        No Limits. Just <span class="text-blue-500">Pure Performance.</span>
      </h1>
      <p class="text-lg lg:text-xl text-zinc-400 mb-10 max-w-2xl mx-auto">
        When Shopify isn't enough. We build high-performance custom websites using Next.js, Astro, and React. Unmatched speed, SEO dominance, and custom functionality.
      </p>
      <div class="flex justify-center">
        <div class="squircle-bg rounded-lg bg-white text-black">
          <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold">
            Book Strategy Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section py-20 bg-white text-zinc-900">
    <div class="col-span-12 lg:col-span-6 lg:col-start-2">
      <h2 class="font-display text-3xl lg:text-5xl font-bold uppercase mb-8">Engineering Your Competitive Advantage.</h2>
      <p class="text-lg text-zinc-600 mb-6">
        Templates restrict your growth. Custom development unlocks it. Whether you need a complex booking system, a B2B portal, or a brand experience that wins awards, we engineer it from scratch. We focus on Core Web Vitals, accessibility, and backend scalability so your site grows with your revenue.
      </p>
      <ul class="space-y-4 text-zinc-800 font-medium">
        <li class="flex items-center gap-2"><span class="text-blue-600">✓</span> High-Performance Frontend (React/Astro)</li>
        <li class="flex items-center gap-2"><span class="text-blue-600">✓</span> Headless CMS Integration</li>
        <li class="flex items-center gap-2"><span class="text-blue-600">✓</span> Enterprise-Grade Security</li>
        <li class="flex items-center gap-2"><span class="text-blue-600">✓</span> Complex API Integrations</li>
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section py-20 bg-zinc-50">
      <div class="col-span-12 text-center mb-16">
          <h2 class="font-display text-4xl font-bold uppercase">Our Development Process</h2>
      </div>
      <div class="col-span-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">01</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Architecture Planning</h3>
              <p class="text-zinc-500">We define the tech stack, database schema, and scalability requirements.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">02</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Agile Development</h3>
              <p class="text-zinc-500">Iterative sprints with regular updates. You see progress every week.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">03</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Technical SEO & Launch</h3>
              <p class="text-zinc-500">Perfect lighthouse scores, schema markup, and zero-downtime deployment.</p>
          </div>
      </div>
  </section>

  <!-- Who It's For -->
  <section class="section py-20 bg-zinc-900 text-white">
      <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
          <h2 class="font-display text-3xl mb-6">Who This Is For</h2>
          <p class="text-xl text-zinc-400">
              Service businesses needing custom functionalities, B2B companies, and brands that have outgrown standard platforms.
          </p>
      </div>
  </section>

  <!-- CTA -->
  <section class="section py-32 bg-blue-500 text-white text-center">
      <div class="col-span-12">
          <h2 class="font-display text-4xl lg:text-6xl font-bold uppercase mb-8">Ready to Build a Revenue System?</h2>
          <div class="flex justify-center">
            <div class="squircle-bg rounded-lg bg-black text-white">
              <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold hover:text-blue-400 transition-colors">
                Book Strategy Call
              </a>
            </div>
          </div>
      </div>
  </section>

</BaseLayout>
