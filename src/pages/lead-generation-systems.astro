---
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = {
  title: "Lead Generation Systems - Growofy",
  description: "High-quality B2B & B2C lead generation campaigns. We build funnels that deliver qualified appointments and sales inquiries.",
};
---

<BaseLayout seo={seo}>
  <!-- Hero Section -->
  <section class="section py-20 lg:py-32 bg-zinc-950 text-white min-h-[70vh] flex items-center">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
      <h1 class="font-display text-5xl lg:text-7xl font-bold uppercase tracking-tight mb-6">
        No More <span class="text-orange-500">Cold Calling.</span>
      </h1>
      <p class="text-lg lg:text-xl text-zinc-400 mb-10 max-w-2xl mx-auto">
        Stop chasing bad leads. We build automated lead generation machines that fill your calendar with qualified prospects ready to buy.
      </p>
      <div class="flex justify-center">
        <div class="squircle-bg rounded-lg bg-white text-black">
          <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold">
            Book Strategy Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section py-20 bg-white text-zinc-900">
    <div class="col-span-12 lg:col-span-6 lg:col-start-2">
      <h2 class="font-display text-3xl lg:text-5xl font-bold uppercase mb-8">Qualification, Not Volume.</h2>
      <p class="text-lg text-zinc-600 mb-6">
        Anyone can get you cheap leads. We get you <em>qualified</em> leads. By implementing pre-qualification forms, specific targeting, and instant follow-ups via WhatsApp and Email, we filter out time-wasters so your sales team only talks to serious buyers.
      </p>
      <ul class="space-y-4 text-zinc-800 font-medium">
        <li class="flex items-center gap-2"><span class="text-orange-600">✓</span> Automated Lead Qualification</li>
        <li class="flex items-center gap-2"><span class="text-orange-600">✓</span> CRM Integration (Zoho, Hubspot, etc.)</li>
        <li class="flex items-center gap-2"><span class="text-orange-600">✓</span> Instant WhatsApp Notifications</li>
        <li class="flex items-center gap-2"><span class="text-orange-600">✓</span> Automated Nurture Sequences</li>
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section py-20 bg-zinc-50">
      <div class="col-span-12 text-center mb-16">
          <h2 class="font-display text-4xl font-bold uppercase">Our Lead Gen Process</h2>
      </div>
      <div class="col-span-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">01</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Offer Design</h3>
              <p class="text-zinc-500">We craft an irresistible "Lead Magnet" or offer to capture attention.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">02</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Funnel Build</h3>
              <p class="text-zinc-500">High-converting landing page + form + thank you page sequence.</p>
          </div>
          <div class="p-8 bg-white rounded-2xl border border-zinc-100 shadow-sm">
              <span class="text-6xl font-display font-bold text-zinc-100">03</span>
              <h3 class="text-xl font-bold mt-4 mb-2">Traffic & Leads</h3>
              <p class="text-zinc-500">Targeted ads drive traffic. Your CRM fills up. Automation follows up.</p>
          </div>
      </div>
  </section>

  <!-- Who It's For -->
  <section class="section py-20 bg-zinc-900 text-white">
      <div class="col-span-12 lg:col-span-8 lg:col-start-3 text-center">
          <h2 class="font-display text-3xl mb-6">Who This Is For</h2>
          <p class="text-xl text-zinc-400">
              Real Estate Agencies, B2B Consultants, Clinics, Coaching Institutes, and Solopreneurs.
          </p>
      </div>
  </section>

  <!-- CTA -->
  <section class="section py-32 bg-orange-500 text-white text-center">
      <div class="col-span-12">
          <h2 class="font-display text-4xl lg:text-6xl font-bold uppercase mb-8">Ready to Build a Revenue System?</h2>
          <div class="flex justify-center">
            <div class="squircle-bg rounded-lg bg-black text-white">
              <a href="/contact" class="flex h-12 items-center px-8 text-lg font-bold hover:text-orange-400 transition-colors">
                Book Strategy Call
              </a>
            </div>
          </div>
      </div>
  </section>

</BaseLayout>
